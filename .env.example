# Canonical origin. Leave unset locally and on previews — the app falls back to
# VERCEL_URL for previews and http://localhost:3000 in development.
# Set this in Vercel (Production scope only) once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# Fail the build while any screenshot, CV file, or TODO placeholder is still
# outstanding. Set ASSETS_STRICT=1 in Vercel once the site is genuinely finished.
ASSETS_STRICT=
